# Backend Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Supabase — new API key standard (Settings > API Keys in dashboard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
SUPABASE_SECRET_KEY=sb_secret_your-secret-key

# Legacy names still supported as fallbacks:
# SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...

# Required to verify Supabase Auth user JWTs from sign-in (Project Settings > API > JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Firebase Cloud Messaging (FCM) Configuration
# Path to service account json OR raw JSON string
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
# FIREBASE_CREDENTIALS_JSON={"type": "service_account", ...}

# SMTP / Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@dayflow.com
